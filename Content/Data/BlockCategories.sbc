<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CategoryClasses>
		<!-- Shared GVK tab - header must match every other GVK mod; list one head block per variant group (StrictSearch shows every listed block) -->
		<Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
			<Id>
				<TypeId>GuiBlockCategoryDefinition</TypeId>
				<SubtypeId/>
			</Id>
			<DisplayName>GV Kharak Items</DisplayName>
			<Name>GVK</Name>
			<StrictSearch>true</StrictSearch>
			<ItemIds>
				<string>Projector/MnMLarge</string>
				<string>Beacon/LargeCargoScanner</string>
				<string>Beacon/LargeBlockBeacon</string>
				<string>Beacon/LimitedProdZone</string>
