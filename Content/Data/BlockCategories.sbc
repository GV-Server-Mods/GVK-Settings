		<!-- Propulsion sub-tab, merged with GVK_HoverEngines' and GVK_Suspension's: the Tank Tracks Builder mod (3209005014), by its group primary -->
		<Category xsi:type="MyObjectBuilder_GuiBlockCategoryDefinition">
			<Id>
				<TypeId>GuiBlockCategoryDefinition</TypeId>
				<SubtypeId/>
			</Id>
