<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<BlockVariantGroups>
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="GVK_Shared_Cargos"/>
			<Icon>Textures\GUI\Icons\Cubes\CargoContainer.dds</Icon>
			<Icon>Textures\Icons\Shared_Icon_Overlay.dds</Icon>
			<DisplayName>Shared Cargo Containers</DisplayName>
			<Description/>
			<Blocks>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockSmallContainer_Shared"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="SmallBlockMediumContainer_Shared"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockLargeContainer_Shared"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockLargeIndustrialContainer_Shared"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- Vanilla overrides below replace Keen's whole group: re-sync with Content\Data\BlockVariantGroups.sbc after game updates -->
		<!-- Overrides AQD - Conveyor Expansion's copy (drops bulk containers and cargo terminals) and keeps its conveyor access block.
		     GVK_Settings must stay above AQD - Conveyor Expansion in the mod list so this one loads last. -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="ContainerGroup"/>
			<Icon>Textures\GUI\Icons\Cubes\container.dds</Icon>
			<DisplayName>DisplayName_BlockGroup_ContainerGroup</DisplayName>
			<Description>Description_BlockGroup_ContainerGroup</Description>
			<Blocks>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockSmallContainer"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockCargoTerminal"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockCargoTerminalHalf"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockLargeContainer"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="SmallBlockSmallContainer"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="SmallBlockMediumContainer"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="SmallBlockLargeContainer"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="SmallBlockModularContainer"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockLargeIndustrialContainer"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockBulkContainerA"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockBulkContainerB"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockBulkContainerC"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="AQD_LG_ConveyorAccess"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- AQD - Conveyor Expansion's (1864380341) reinforced duct group plus the four Extra Reinforced Conveyors (2800974378) ducts, which that mod puts in
		     ConveyorThickGroup; AQD loads later and replaces that group without them (owner, 2026-11-23: "Into reinforced ducts") -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="ConveyorReinforcedGroup"/>
			<Icon>Textures\GUI\Icons\Cubes\ConveyorDuct.dds</Icon>
			<DisplayName>DisplayName_ConveyorTubeDuct</DisplayName>
			<Description>Description_ConveyorTubeDuct</Description>
			<Blocks>
				<Block Type="MyObjectBuilder_ConveyorConnector" Subtype="ConveyorTubeDuct"/>
				<Block Type="MyObjectBuilder_ConveyorConnector" Subtype="ConveyorTubeDuctCurved"/>
				<Block Type="MyObjectBuilder_Conveyor" Subtype="ConveyorTubeDuctT"/>
				<Block Type="MyObjectBuilder_Conveyor" Subtype="Conveyor4WayDuct"/>
				<Block Type="MyObjectBuilder_Conveyor" Subtype="ConveyorElbowDuct"/>
				<Block Type="MyObjectBuilder_Conveyor" Subtype="Conveyor4WayAltDuct"/>
				<Block Type="MyObjectBuilder_Conveyor" Subtype="Conveyor5WayDuct"/>
				<Block Type="MyObjectBuilder_ConveyorConnector" Subtype="ConveyorTubeDuctSmall"/>
				<Block Type="MyObjectBuilder_ConveyorConnector" Subtype="ConveyorTubeDuctSmallCurved"/>
				<Block Type="MyObjectBuilder_Conveyor" Subtype="ConveyorTubeDuctSmallT"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- Keeps vanilla Id so the vanilla radial-menu beacon slot shows the GVK core beacons -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="BeaconGroup"/>
			<Icon>Textures\GUI\Icons\Cubes\Core_Light.dds</Icon>
			<DisplayName>Core Beacons</DisplayName>
			<Description>Description_Beacon</Description>
			<Blocks>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="SmallBlockBeacon"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_MediumCore"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_SupportCore"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_HeavyCore"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_Fortress"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_Pipeline"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_ShieldCore"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_Scrap"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="SmallBlockBeacon_Scrap"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeaconReskin"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="SmallBlockBeaconReskin"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- Vanilla group + Prototech reactor (Advanced Hydrogen Engine, Fortress only) -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="HydrogenEngineGroup"/>
			<Icon>Textures\GUI\Icons\Cubes\HydrogenEngineLarge.dds</Icon>
			<DisplayName>DisplayName_Block_Hydrogen_Engine</DisplayName>
			<Description>Description_PowerGenerator</Description>
			<Blocks>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="LargeHydrogenEngine"/>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="LargeHydrogenEngineReskin"/>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="SmallHydrogenEngine"/>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="SmallHydrogenEngineReskin"/>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="LargePrototechReactor"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- Staff and NPC blocks in one Home icon (owner, 2026-11-22). SafeZoneBlockNPC is from the siegable safe zones mod (3605260551); the game drops it if that mod is not loaded. -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="GVK_AdminBlocks"/>
			<DisplayName>GVK Admin Blocks</DisplayName>
			<Description/>
			<Blocks>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LimitedProdZone"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="GVK_NoLargeGridZone"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="GVK_NoThrusterZone"/>
				<Block Type="MyObjectBuilder_Refinery" Subtype="LargeRefinery_NPC_CU"/>
				<Block Type="MyObjectBuilder_SafeZoneBlock" Subtype="SafeZoneBlockNPC"/>
				<!-- King of the Hill (SkunkWorks, 2863919629) -->
				<Block Type="MyObjectBuilder_Beacon" Subtype="ZoneBlock"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="Prizebox"/>
				<!-- GVK admin blockers (Cubeblocks/GVK_Blockers.sbc), replacing SC Blockers (2661300547), whose own group is disabled below -->
				<Block Type="MyObjectBuilder_TerminalBlock" Subtype="GVK_Blocker_200x200"/>
				<Block Type="MyObjectBuilder_TerminalBlock" Subtype="GVK_Blocker_100x100"/>
				<Block Type="MyObjectBuilder_TerminalBlock" Subtype="GVK_Blocker_50x50"/>
				<Block Type="MyObjectBuilder_TerminalBlock" Subtype="GVK_Blocker_200x100"/>
				<Block Type="MyObjectBuilder_TerminalBlock" Subtype="GVK_Blocker_200x50"/>
				<Block Type="MyObjectBuilder_TerminalBlock" Subtype="GVK_Blocker_100x50"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- Keen's TankGroup plus the GVK Medium Hydrogen Tank. Also keeps the Water Tank mod's (3633905517) WaterTank, since that mod redefines this group too and the last loaded wins. -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="TankGroup"/>
			<Icon>Textures\GUI\Icons\Cubes\OxygenTank.dds</Icon>
			<DisplayName>DisplayName_BlockGroup_TankGroup</DisplayName>
			<Description>Description_BlockGroup_TankGroup</Description>
			<Blocks>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype=""/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="SmallOxygenTankSmall"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="OxygenTankSmall"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="LargeBlockOxygenTankLab"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="LargeHydrogenTank"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="LargeHydrogenTankSmall"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="LargeHydrogenTankSmallLab"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="SmallHydrogenTankLab"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="SmallHydrogenTank"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="SmallHydrogenTankSmall"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="LargeHydrogenTankIndustrial"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="LargeHydrogenTankBulk"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="SmallHydrogenTankBulk"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="WaterTank"/>
				<Block Type="MyObjectBuilder_OxygenTank" Subtype="RB_HydrogenTankMedium_Small"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- SC Blockers' shapes live in GVK Admin Blocks (owner, 2026-11-22); works when GVK_Settings loads after SC Blockers -->
		<BlockVariantGroup Enabled="false">
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="BlockerCubeGroup"/>
			<Blocks/>
		</BlockVariantGroup>
		<!-- Spawn_Point_IR (1738223560): large and small spawn point in one icon -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="GVK_SpawnPoints"/>
			<DisplayName>Spawn Points</DisplayName>
			<Description/>
			<Blocks>
				<Block Type="MyObjectBuilder_MedicalRoom" Subtype="Spawn_Point_IR"/>
				<Block Type="MyObjectBuilder_MedicalRoom" Subtype="Small_Spawn_Point_IR"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- Longer Hangar Doors (3419249780): the three lengths in one icon -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="GVK_LongHangarDoors"/>
			<DisplayName>Long Hangar Doors</DisplayName>
			<Description/>
			<Blocks>
				<Block Type="MyObjectBuilder_AirtightHangarDoor" Subtype="UOH_Hangar_x3"/>
				<Block Type="MyObjectBuilder_AirtightHangarDoor" Subtype="UOH_Hangar_x4"/>
				<Block Type="MyObjectBuilder_AirtightHangarDoor" Subtype="UOH_Hangar_x5"/>
			</Blocks>
		</BlockVariantGroup>
	</BlockVariantGroups>
</Definitions>
