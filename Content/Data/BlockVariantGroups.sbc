<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<BlockVariantGroups>
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="GVK_Shared_Cargos"/>
			<Icon>Textures\GUI\Icons\Cubes\CargoContainer.dds</Icon>
			<Icon>Textures\Icons\Shared_Icon_Overlay.dds</Icon>
			<DisplayName>Shared Cargo Containers</DisplayName>
			<Description/>
			<Blocks>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockSmallContainer_Shared"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="SmallBlockMediumContainer_Shared"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockLargeContainer_Shared"/>
				<Block Type="MyObjectBuilder_CargoContainer" Subtype="LargeBlockLargeIndustrialContainer_Shared"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- Vanilla overrides below replace Keen's whole group: re-sync with Content\Data\BlockVariantGroups.sbc after game updates -->
		<!-- Keeps vanilla Id so the vanilla radial-menu beacon slot shows the GVK core beacons -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="BeaconGroup"/>
			<Icon>Textures\GUI\Icons\Cubes\beacon.dds</Icon>
			<DisplayName>Core Beacons</DisplayName>
			<Description>Description_Beacon</Description>
			<Blocks>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="SmallBlockBeacon"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_MediumCore"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_HeavyCore"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_Fortress"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_Pipeline"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_ShieldCore"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeacon_Scrap"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="SmallBlockBeacon_Scrap"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="LargeBlockBeaconReskin"/>
				<Block Type="MyObjectBuilder_Beacon" Subtype="SmallBlockBeaconReskin"/>
			</Blocks>
		</BlockVariantGroup>
		<!-- Vanilla group + Prototech reactor (Advanced Hydrogen Engine, Fortress only) -->
		<BlockVariantGroup>
			<Id Type="MyObjectBuilder_BlockVariantGroup" Subtype="HydrogenEngineGroup"/>
			<Icon>Textures\GUI\Icons\Cubes\HydrogenEngineLarge.dds</Icon>
			<DisplayName>DisplayName_Block_Hydrogen_Engine</DisplayName>
			<Description>Description_PowerGenerator</Description>
			<Blocks>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="LargeHydrogenEngine"/>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="LargeHydrogenEngineReskin"/>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="SmallHydrogenEngine"/>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="SmallHydrogenEngineReskin"/>
				<Block Type="MyObjectBuilder_HydrogenEngine" Subtype="LargePrototechReactor"/>
			</Blocks>
		</BlockVariantGroup>
	</BlockVariantGroups>
</Definitions>
