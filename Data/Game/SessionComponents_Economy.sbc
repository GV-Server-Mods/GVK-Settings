<?xml version="1.0" encoding="UTF-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <!--Definition for container economy system-->
    <Definition xsi:type="MyObjectbuilder_SessionComponentEconomyDefinition">
        <Id>
            <TypeId>MyObjectbuilder_SessionComponentEconomyDefinition</TypeId>
            <SubtypeId>Default</SubtypeId>
        </Id>

		<!-- Added fees here because they are not in the Mod API whitelist
			
			TODO: This may be different now with Econ2, need to verify.
			
		-->
		<ListingFee>0</ListingFee>
		<TransactionFee>0</TransactionFee>

        <PerFactionInitialCurrency>1000000000</PerFactionInitialCurrency>
        <DeepSpaceStationStoreBonus>0.05</DeepSpaceStationStoreBonus>
        <DeepSpaceStationContractBonus>1.1</DeepSpaceStationContractBonus>

        <RepMult_Pos_Owner>1</RepMult_Pos_Owner>
        <RepMult_Pos_Friend>0.25</RepMult_Pos_Friend>
        <RepMult_Pos_Neutral>0</RepMult_Pos_Neutral>
        <RepMult_Pos_Enemy>0</RepMult_Pos_Enemy>

        <RepMult_Neg_Owner>1</RepMult_Neg_Owner>
        <RepMult_Neg_Friend>0.5</RepMult_Neg_Friend>
        <RepMult_Neg_Neutral>0</RepMult_Neg_Neutral>
        <RepMult_Neg_Enemy>-0.25</RepMult_Neg_Enemy>

        <ReputationHostileMin>-1500</ReputationHostileMin>
        <ReputationHostileMid>-1000</ReputationHostileMid>
        <ReputationNeutralMin>-500</ReputationNeutralMin>
        <ReputationNeutralMid>0</ReputationNeutralMid>
        <ReputationFriendlyMin>500</ReputationFriendlyMin>
        <ReputationFriendlyMid>1000</ReputationFriendlyMid>
        <ReputationFriendlyMax>1500</ReputationFriendlyMax>

        <ReputationDecayPerHour>50</ReputationDecayPerHour>

        <ReputationLevelValue>1000</ReputationLevelValue>
        <ReputationPlayerDefault>0</ReputationPlayerDefault>
        <StoreCreationLimitPerPlayer>50</StoreCreationLimitPerPlayer> <!-- Maximuim number of items that can be listed per store blocks. Accepted value range is between 1-50 -->

        <Station_Distance_MinimalFromOtherStation>10000</Station_Distance_MinimalFromOtherStation>

        <FactionBalanceRecoveryModifier>0.4</FactionBalanceRecoveryModifier> <!-- Simulates a background economy and gradually normalizes the wealth of each faction with each economy update. Formula: New Currency = Current Currency + (PerFactionInitialCurrency - Current Currency) * Recovery modifier -->

        <PirateId>
            <TypeId>MyObjectBuilder_FactionDefinition</TypeId>
            <SubtypeId>GVK_Gaalsien_Faction</SubtypeId>
        </PirateId>
        <DatapadDefinition>
            <TypeId>MyObjectBuilder_Datapad</TypeId>
            <SubtypeId>Datapad</SubtypeId>
        </DatapadDefinition>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_SessionComponentContractSystemDefinition">
        <Id>
            <TypeId>MyObjectBuilder_SessionComponentContractSystemDefinition</TypeId>
            <SubtypeId>Default</SubtypeId>
        </Id>
        <ContractPerPlayerLimit>3</ContractPerPlayerLimit>
    <Definition xsi:type="MyObjectBuilder_ContractRiskDefinition">
        <Id>
            <TypeId>MyObjectBuilder_ContractRiskDefinition</TypeId>
            <SubtypeId>Default</SubtypeId>
        </Id>
        <CheckIntervalFrames>100</CheckIntervalFrames>
        <SpawnDistanceFromPlayer>500</SpawnDistanceFromPlayer>
        <DespawnDistance>16500</DespawnDistance>
    </Definition>
    <Definition xsi:type="MyObjectBuilder_SessionComponentItemTriggeredContractsDefinition">
        <Id>
            <TypeId>MyObjectBuilder_SessionComponentItemTriggeredContractsDefinition</TypeId>
            <SubtypeId>Default</SubtypeId>
        </Id>
        <SpawnChance>0.35</SpawnChance>
        <AllowEnemyFactions>true</AllowEnemyFactions>
        <ContractEntries>
            <ContractEntryData>
                <Weight>1</Weight>
                <ContractSubtypeId>Deliver_EncryptedDataStorage</ContractSubtypeId>
                <ItemSubtypeId>EncryptedDataStorage</ItemSubtypeId>
            </ContractEntryData>
            <ContractEntryData>
                <Weight>1</Weight>
                <ContractSubtypeId>Deliver_InterceptedTransmissions</ContractSubtypeId>
                <ItemSubtypeId>InterceptedTransmissions</ItemSubtypeId>
            </ContractEntryData>
            <ContractEntryData>
                <Weight>1</Weight>
                <ContractSubtypeId>Deliver_ResearchMaterials</ContractSubtypeId>
                <ItemSubtypeId>ResearchMaterials</ItemSubtypeId>
            </ContractEntryData>
            <ContractEntryData>
                <Weight>1</Weight>
                <ContractSubtypeId>Deliver_SmuggledGoods</ContractSubtypeId>
                <ItemSubtypeId>SmuggledGoods</ItemSubtypeId>
            </ContractEntryData>
            <ContractEntryData>
                <Weight>1</Weight>
                <ContractSubtypeId>Deliver_TechnicalBlueprints</ContractSubtypeId>
                <ItemSubtypeId>TechnicalBlueprints</ItemSubtypeId>
            </ContractEntryData>
        </ContractEntries>
    </Definition>
    </Definition>
</Definitions>
